# Inject these variables through your process manager/container environment.
# server.mjs does not automatically read .env (compatible with Node 20).
PORT=4173
BASE_PATH=/game-werewolf261020
TURN_PROVIDER=none
TURN_TTL_SECONDS=3600
ICE_TRANSPORT_POLICY=all

# TURN_PROVIDER=cloudflare
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# TURN_PROVIDER=coturn; shared secret matches coturn static-auth-secret.
TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
TURN_SHARED_SECRET=
